<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://jitse.be/rusttv" version="1.5.0" viewmodes="maximized">
    <tizen:application id="RustTVjvh1.RustTV" package="RustTVjvh1" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Rust TV</name>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    <access origin="*" subdomains="true"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:service id="RustTVjvh1.Wachter" auto-restart="true" on-boot="false">
        <tizen:content src="service/wachter.js"/>
        <tizen:name>Wachter</tizen:name>
        <tizen:icon src="icon.png"/>
        <tizen:description>Opent Rust TV als de tv wakker wordt</tizen:description>
        <tizen:category name="http://tizen.org/category/service"/>
    </tizen:service>
</widget>
